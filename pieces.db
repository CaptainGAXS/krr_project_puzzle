% ----------------------------------------------------
% ----------------------------------------------------
% ----------------------------------------------------

piece(P) :- bit(P, _, _, _).

% ----------------------------------------------------
% base piece and variants generation

% The 24 possible rotations of a 3D-pieces
% rot(ID, Permutation_X, Permutation_Y, Permutation_Z, SignX, SignY, SignZ)
rot(1,1,2,3, 1,1,1).  rot(2,1,2,3, 1,-1,-1). rot(3,1,2,3, -1,1,-1). rot(4,1,2,3, -1,-1,1).
rot(5,1,3,2, 1,1,-1). rot(6,1,3,2, 1,-1,1).  rot(7,1,3,2, -1,1,1).  rot(8,1,3,2, -1,-1,-1).
rot(9,2,1,3, 1,1,-1). rot(10,2,1,3, 1,-1,1). rot(11,2,1,3, -1,1,1). rot(12,2,1,3, -1,-1,-1).
rot(13,2,3,1, 1,1,1). rot(14,2,3,1, 1,-1,-1). rot(15,2,3,1, -1,1,-1). rot(16,2,3,1, -1,-1,1).
rot(17,3,1,2, 1,1,1). rot(18,3,1,2, 1,-1,-1). rot(19,3,1,2, -1,1,-1). rot(20,3,1,2, -1,-1,1).
rot(21,3,2,1, 1,1,-1). rot(22,3,2,1, 1,-1,1). rot(23,3,2,1, -1,1,1). rot(24,3,2,1, -1,-1,-1).

% Apply a rotation R to the bits of a piece P, with scaling by signs (SX, SY, SZ)
apply_rot(P, R, SX*X, SY*Y, SZ*Z) :- bit(P, X, Y, Z), rot(R, 1, 2, 3, SX, SY, SZ).
apply_rot(P, R, SX*X, SY*Z, SZ*Y) :- bit(P, X, Y, Z), rot(R, 1, 3, 2, SX, SY, SZ).
apply_rot(P, R, SX*Y, SY*X, SZ*Z) :- bit(P, X, Y, Z), rot(R, 2, 1, 3, SX, SY, SZ).
apply_rot(P, R, SX*Y, SY*Z, SZ*X) :- bit(P, X, Y, Z), rot(R, 2, 3, 1, SX, SY, SZ).
apply_rot(P, R, SX*Z, SY*X, SZ*Y) :- bit(P, X, Y, Z), rot(R, 3, 1, 2, SX, SY, SZ).
apply_rot(P, R, SX*Z, SY*Y, SZ*X) :- bit(P, X, Y, Z), rot(R, 3, 2, 1, SX, SY, SZ).

% Normalize the rotated piece by translating it so that its minimum coordinates are at the origin (0,0,0)
min_coords(P, R, MX, MY, MZ) :- 
    apply_rot(P, R, _, _, _),
    MX = #min { X : apply_rot(P, R, X, _, _) },
    MY = #min { Y : apply_rot(P, R, _, Y, _) },
    MZ = #min { Z : apply_rot(P, R, _, _, Z) }.

norm_bit(P, R, X-MX, Y-MY, Z-MZ) :- 
    apply_rot(P, R, X, Y, Z), 
    min_coords(P, R, MX, MY, MZ).

% Keep only unique variants of each piece (remove duplicates)
rot_id(R) :- rot(R, _, _, _, _, _, _).

valid_rot(P, R) :-
    piece(P),
    rot_id(R),
    norm_bit(P, R, _, _, _).

diff(P, R1, R2) :-
    valid_rot(P, R1),
    valid_rot(P, R2),
    norm_bit(P, R1, X, Y, Z),
    not norm_bit(P, R2, X, Y, Z).

same_shape(P, R1, R2) :-
    valid_rot(P, R1),
    valid_rot(P, R2),
    not diff(P, R1, R2),
    not diff(P, R2, R1).

smaller_equiv(P, R) :-
    valid_rot(P, R),
    valid_rot(P, R2),
    R2 < R,
    same_shape(P, R, R2).

keep_rot(P, R) :-
    valid_rot(P, R),
    not smaller_equiv(P, R).

% for the selection of the pieces depending on the associated_n value (n = number of layer)
size4(P) :- bit(P,_,_,_), 4 = #count { X,Y,Z : bit(P,X,Y,Z) }.
size5(P) :- bit(P,_,_,_), 5 = #count { X,Y,Z : bit(P,X,Y,Z) }.
#const n=1.
use(P) :-
    piece(P),
    associated_n(P, K),
    K <= n.


% p3(PIECE, VARIANT, X, Y, Z)
p3(P, R, X, Y, Z) :-
    norm_bit(P, R, X, Y, Z),
    keep_rot(P, R),
    use(P).

% -----------------------
% Define a weight for each material
material_weight(iron, 7).
material_weight(stone, 5).
material_weight(wood, 3).
material_weight(dirt, 1).
