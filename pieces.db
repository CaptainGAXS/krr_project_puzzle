% ----------------
piece(P) :- bit(P, _, _, _).

% p3(Name, ID, X, Y, Z)
% base piece and variants generation
raw_p3(P, 0, X, Y, Z) :- bit(P, X, Y, Z).

% 3D even permutations (0 or 2 swaps)
raw_p3(P, (1, SX, SY, SZ),  SX*X, SY*Y, SZ*Z) :- bit(P, X, Y, Z), SX= (1;-1), SY= (1;-1), SZ= (1;-1), SX*SY*SZ ==  1.
raw_p3(P, (2, SX, SY, SZ),  SX*Y, SY*Z, SZ*X) :- bit(P, X, Y, Z), SX= (1;-1), SY= (1;-1), SZ= (1;-1), SX*SY*SZ ==  1.
raw_p3(P, (3, SX, SY, SZ),  SX*Z, SY*X, SZ*Y) :- bit(P, X, Y, Z), SX= (1;-1), SY= (1;-1), SZ= (1;-1), SX*SY*SZ ==  1.

% 3D odd permutations (1 swap)
raw_p3(P, (4, SX, SY, SZ),  SX*X, SY*Z, SZ*Y) :- bit(P, X, Y, Z), SX= (1;-1), SY= (1;-1), SZ= (1;-1), SX*SY*SZ == -1.
raw_p3(P, (5, SX, SY, SZ),  SX*Z, SY*Y, SZ*X) :- bit(P, X, Y, Z), SX= (1;-1), SY= (1;-1), SZ= (1;-1), SX*SY*SZ == -1.
raw_p3(P, (6, SX, SY, SZ),  SX*Y, SY*X, SZ*Z) :- bit(P, X, Y, Z), SX= (1;-1), SY= (1;-1), SZ= (1;-1), SX*SY*SZ == -1.

variant(P, V) :- raw_p3(P, V, _, _, _).

% Calculate bounds to normalize coordinates to 0 for each variant
min_x(P, V, M) :- variant(P, V), M = #min { X : raw_p3(P, V, X, _, _) }.
min_y(P, V, M) :- variant(P, V), M = #min { Y : raw_p3(P, V, _, Y, _) }.
min_z(P, V, M) :- variant(P, V), M = #min { Z : raw_p3(P, V, _, _, Z) }.

norm_p3(P, V, X-MX, Y-MY, Z-MZ) :- raw_p3(P, V, X, Y, Z), min_x(P, V, MX), min_y(P, V, MY), min_z(P, V, MZ).

% Deduplicate identical variants
diff(P, V1, V2) :- norm_p3(P, V1, X, Y, Z), not norm_p3(P, V2, X, Y, Z), variant(P, V2).
same(P, V1, V2) :- variant(P, V1), variant(P, V2), not diff(P, V1, V2), not diff(P, V2, V1).

% Keep the smallest variant ID for identical shapes
keep(P, V) :- variant(P, V), V = #min { V2 : same(P, V, V2) }.

p3(P, V, X, Y, Z) :- norm_p3(P, V, X, Y, Z), keep(P, V).



